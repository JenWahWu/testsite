<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Li &amp; Jenny — 7 September 2026</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;1,300;1,400&family=Jost:wght@200;300;400&display=swap" rel="stylesheet">

<style>

/* ─────────────────────────────────────────────
   RESET & TOKENS
───────────────────────────────────────────── */
*, *::before, *::after {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

:root {
  --ivory:  #f7f3ec;
  --cream:  #ede5d4;
  --forest: #2d4a3e;
  --sage:   #7a9e8e;
  --gold:   #b8976a;
  --dark:   #1a2820;
  --text:   #3a3028;
  --muted:  #5a5040;
}

html {
  scroll-behavior: smooth;
  -webkit-text-size-adjust: 100%;
}

body {
  background: var(--ivory);
  color: var(--text);
  font-family: 'Jost', sans-serif;
  font-weight: 300;
  overflow-x: hidden;
  line-height: 1.6;
}

/* ─────────────────────────────────────────────
   HERO
───────────────────────────────────────────── */
.hero {
  min-height: 100svh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  position: relative;
  background: var(--forest);
  overflow: hidden;
  padding: 4rem 1.5rem 5rem;
}

/* layered radial glows */
.hero::before {
  content: '';
  position: absolute;
  inset: 0;
  background:
    radial-gradient(ellipse 80% 60% at 15% 85%, rgba(122,158,142,.28) 0%, transparent 55%),
    radial-gradient(ellipse 55% 70% at 85% 15%, rgba(184,151,106,.18) 0%, transparent 50%);
  pointer-events: none;
}

/* botanical SVG corner — top-left */
.hero-bot-tl,
.hero-bot-br {
  position: absolute;
  width: clamp(180px, 30vw, 320px);
  opacity: .16;
  pointer-events: none;
}
.hero-bot-tl { top: 0; left: 0; }
.hero-bot-br { bottom: 0; right: 0; transform: rotate(180deg); }

.hero-inner {
  position: relative;
  z-index: 2;
  text-align: center;
  animation: heroFade 1.2s ease both;
}

.eyebrow {
  font-weight: 200;
  font-size: clamp(.65rem, 2vw, .75rem);
  letter-spacing: .38em;
  text-transform: uppercase;
  color: var(--sage);
  margin-bottom: 2.2rem;
  animation: fadeUp .9s .15s both;
}

.names {
  font-family: 'Cormorant Garamond', serif;
  font-weight: 300;
  font-size: clamp(4rem, 16vw, 9.5rem);
  line-height: .92;
  color: var(--ivory);
  letter-spacing: -.01em;
  animation: fadeUp 1s .4s both;
}
.names em {
  font-style: italic;
  color: var(--gold);
}

/* ornament divider */
.ornament {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: .9rem;
  margin: 2.4rem auto;
  animation: fadeUp .8s .65s both;
}
.ornament::before,
.ornament::after {
  content: '';
  display: block;
  width: clamp(50px, 10vw, 90px);
  height: 1px;
}
.ornament::before { background: linear-gradient(to right, transparent, var(--gold)); }
.ornament::after  { background: linear-gradient(to left,  transparent, var(--gold)); }
.ornament-diamond {
  width: 6px;
  height: 6px;
  background: var(--gold);
  transform: rotate(45deg);
  flex-shrink: 0;
}

.date-loc {
  font-family: 'Cormorant Garamond', serif;
  font-size: clamp(1rem, 3vw, 1.35rem);
  font-weight: 400;
  color: var(--cream);
  letter-spacing: .13em;
  animation: fadeUp .8s .85s both;
}

/* scroll indicator — pure CSS pulse */
.scroll-cue {
  position: absolute;
  bottom: 2rem;
  left: 50%;
  transform: translateX(-50%);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: .45rem;
  color: var(--sage);
  font-size: .62rem;
  letter-spacing: .28em;
  text-transform: uppercase;
  animation: fadeUp .7s 1.5s both;
  text-decoration: none;
}
.scroll-cue::after {
  content: '';
  display: block;
  width: 1px;
  height: 38px;
  background: var(--sage);
  animation: linePulse 2s 1.8s ease-in-out infinite;
}

/* ─────────────────────────────────────────────
   SECTION SHARED
───────────────────────────────────────────── */
.section-wrap {
  padding: clamp(4rem, 10vw, 7rem) clamp(1.25rem, 5vw, 3rem);
}

.label {
  font-weight: 200;
  font-size: .68rem;
  letter-spacing: .32em;
  text-transform: uppercase;
  color: var(--sage);
  margin-bottom: .9rem;
}

.heading {
  font-family: 'Cormorant Garamond', serif;
  font-weight: 300;
  font-size: clamp(2.2rem, 6vw, 3.8rem);
  line-height: 1.08;
  color: var(--forest);
}
.heading em {
  font-style: italic;
  color: var(--gold);
}

/* ─────────────────────────────────────────────
   LOCATIONS
───────────────────────────────────────────── */
.locations {
  background: var(--ivory);
  padding: 0;
}

.loc-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  max-width: 1140px;
  margin: 0 auto;
}

.loc-card {
  padding: clamp(3rem, 7vw, 5.5rem) clamp(2rem, 5vw, 4.5rem);
  position: relative;
  overflow: hidden;
}

.loc-card + .loc-card {
  border-left: 1px solid var(--cream);
}

/* large numeral watermark */
.loc-card::after {
  content: attr(data-num);
  position: absolute;
  top: clamp(2rem, 5vw, 4rem);
  right: clamp(1rem, 3vw, 2.5rem);
  font-family: 'Cormorant Garamond', serif;
  font-size: clamp(4.5rem, 9vw, 8rem);
  font-weight: 300;
  color: var(--cream);
  line-height: 1;
  pointer-events: none;
  user-select: none;
}

.loc-badge {
  display: inline-block;
  font-weight: 200;
  font-size: .66rem;
  letter-spacing: .28em;
  text-transform: uppercase;
  color: var(--gold);
  border: 1px solid rgba(184,151,106,.5);
  padding: .28rem .85rem;
  margin-bottom: 1.8rem;
}

.loc-name {
  font-family: 'Cormorant Garamond', serif;
  font-weight: 400;
  font-size: clamp(1.9rem, 4.5vw, 3rem);
  color: var(--forest);
  line-height: 1;
  margin-bottom: .35rem;
}

.loc-region {
  font-size: .72rem;
  letter-spacing: .18em;
  text-transform: uppercase;
  color: var(--sage);
  margin-bottom: 1.7rem;
}

.loc-desc {
  font-size: clamp(.85rem, 2vw, .95rem);
  line-height: 1.88;
  color: var(--muted);
  margin-bottom: 1.8rem;
  max-width: 42ch;
}

.loc-meta {
  display: flex;
  flex-direction: column;
  gap: .65rem;
}

.loc-row {
  display: flex;
  align-items: flex-start;
  gap: .7rem;
  font-size: .82rem;
  color: #6a5e50;
  line-height: 1.5;
}
.loc-row svg {
  flex-shrink: 0;
  margin-top: 2px;
  color: var(--sage);
}

/* ─────────────────────────────────────────────
   PROGRAM
───────────────────────────────────────────── */
.program {
  background: var(--forest);
  position: relative;
  overflow: hidden;
}

.program::before {
  content: '';
  position: absolute;
  inset: 0;
  background:
    radial-gradient(ellipse 65% 50% at 92% 8%,  rgba(184,151,106,.1) 0%, transparent 55%),
    radial-gradient(ellipse 50% 65% at 4% 92%,  rgba(122,158,142,.1) 0%, transparent 55%);
  pointer-events: none;
}

.program-inner {
  position: relative;
  z-index: 1;
  max-width: 820px;
  margin: 0 auto;
}

.program .label  { color: var(--sage); }
.program .heading { color: var(--ivory); margin-bottom: 3.5rem; }

/* timeline */
.timeline {
  position: relative;
  padding-left: 2.2rem;
}

.timeline::before {
  content: '';
  position: absolute;
  left: 0;
  top: 10px;
  bottom: 10px;
  width: 1px;
  background: linear-gradient(to bottom, transparent 0%, var(--gold) 8%, var(--gold) 92%, transparent 100%);
}

.tl-item {
  display: grid;
  grid-template-columns: 72px 1fr;
  gap: .6rem 1.6rem;
  margin-bottom: 2.8rem;
  position: relative;
}

/* dot on timeline */
.tl-item::before {
  content: '';
  position: absolute;
  left: -2.2rem;
  top: .55rem;
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: var(--gold);
  transform: translateX(calc(-3.5px + 1px));
}

.tl-time {
  font-family: 'Cormorant Garamond', serif;
  font-size: 1.15rem;
  color: var(--gold);
  font-weight: 400;
  padding-top: .1rem;
  text-align: right;
  white-space: nowrap;
}

.tl-title {
  font-family: 'Cormorant Garamond', serif;
  font-size: clamp(1.15rem, 3vw, 1.4rem);
  font-weight: 400;
  color: var(--ivory);
  margin-bottom: .25rem;
  line-height: 1.2;
}

.tl-desc {
  font-size: clamp(.8rem, 2vw, .875rem);
  color: rgba(247,243,236,.5);
  line-height: 1.75;
  max-width: 55ch;
}

.tl-place {
  display: inline-flex;
  align-items: center;
  gap: .35rem;
  font-size: .67rem;
  letter-spacing: .18em;
  text-transform: uppercase;
  color: var(--sage);
  margin-top: .5rem;
}
.tl-place svg { flex-shrink: 0; }

/* travel divider item */
.tl-travel .tl-title {
  font-style: italic;
  color: rgba(247,243,236,.55);
}
.tl-travel .tl-desc {
  color: rgba(247,243,236,.35);
}

/* ─────────────────────────────────────────────
   FOOTER
───────────────────────────────────────────── */
footer {
  background: var(--dark);
  text-align: center;
  padding: clamp(3rem, 8vw, 5rem) 1.5rem;
}

.footer-names {
  font-family: 'Cormorant Garamond', serif;
  font-weight: 300;
  font-style: italic;
  font-size: clamp(1.9rem, 6vw, 2.6rem);
  color: var(--ivory);
  margin-bottom: .7rem;
}

.footer-date {
  font-size: .7rem;
  letter-spacing: .3em;
  text-transform: uppercase;
  color: var(--sage);
}

/* ─────────────────────────────────────────────
   ANIMATIONS  (CSS-only)
───────────────────────────────────────────── */
@keyframes fadeUp {
  from { opacity: 0; transform: translateY(22px); }
  to   { opacity: 1; transform: translateY(0); }
}

@keyframes linePulse {
  0%, 100% { opacity: .25; transform: scaleY(1);   }
  50%       { opacity: 1;   transform: scaleY(.55); transform-origin: top; }
}

/* scroll-driven fade-in for section content */
@supports (animation-timeline: scroll()) {
  .fade-section {
    animation: fadeUp linear both;
    animation-timeline: view();
    animation-range: entry 0% entry 30%;
  }
}

/* fallback for browsers without scroll timeline */
@supports not (animation-timeline: scroll()) {
  .fade-section {
    /* just show everything */
    opacity: 1;
    transform: none;
  }
}

/* ─────────────────────────────────────────────
   RESPONSIVE — TABLET  ≤ 900px
───────────────────────────────────────────── */
@media (max-width: 900px) {
  .loc-grid {
    grid-template-columns: 1fr;
  }
  .loc-card + .loc-card {
    border-left: none;
    border-top: 1px solid var(--cream);
  }
  .loc-card::after {
    font-size: clamp(3.5rem, 10vw, 5.5rem);
    top: 1.8rem;
    right: 1.5rem;
  }
  .loc-desc {
    max-width: 100%;
  }
}

/* ─────────────────────────────────────────────
   RESPONSIVE — MOBILE  ≤ 520px
───────────────────────────────────────────── */
@media (max-width: 520px) {
  /* hero */
  .hero {
    padding: 3rem 1.25rem 4.5rem;
  }
  .hero-bot-tl,
  .hero-bot-br {
    width: 150px;
  }
  .names {
    font-size: clamp(3.6rem, 18vw, 5rem);
  }
  .ornament::before,
  .ornament::after {
    width: 40px;
  }

  /* locations */
  .loc-card {
    padding: 2.8rem 1.4rem;
  }
  .loc-card::after {
    display: none; /* hide numeral on very small screens to avoid overlap */
  }
  .loc-badge {
    font-size: .62rem;
    padding: .25rem .7rem;
  }
  .loc-desc {
    font-size: .88rem;
  }

  /* program */
  .program-inner {
    /* padding already handled by .section-wrap */
  }
  .timeline {
    padding-left: 1.6rem;
  }
  .tl-item {
    grid-template-columns: 58px 1fr;
    gap: .4rem 1rem;
    margin-bottom: 2.2rem;
  }
  .tl-item::before {
    left: -1.6rem;
    top: .5rem;
    width: 6px;
    height: 6px;
  }
  .tl-time {
    font-size: 1rem;
  }
  .tl-title {
    font-size: 1.1rem;
  }
  .tl-desc {
    font-size: .8rem;
  }
}

/* ─────────────────────────────────────────────
   UTILITY
───────────────────────────────────────────── */
.sr-only {
  position: absolute; width: 1px; height: 1px;
  overflow: hidden; clip: rect(0,0,0,0); white-space: nowrap;
}

</style>
</head>
<body>

