    <p class="label">7 September 2026</p>
    <h2 class="heading" id="prog-heading">The <em>Day</em></h2>

    <ol class="timeline" aria-label="Day programme">

      <li class="tl-item fade-section">
        <div class="tl-time">10:30</div>
