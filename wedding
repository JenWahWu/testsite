════════════════════════════════════════════ -->
<section class="locations" id="locations" aria-labelledby="loc-heading">
  <h2 class="sr-only" id="loc-heading">Locations</h2>

  <div class="loc-grid">

    <!-- BAARN -->
    <div class="loc-card fade-section" data-num="I">
